{
  "name": "Rebuilt \u00b7 Python 3.13",
  "image": "mcr.microsoft.com/devcontainers/python:3.13-bookworm",
  "customizations": {
    "codespaces": {
      "openFiles": [
        "README.md",
        "app.py"
      ]
    },
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance"
      ]
    }
  },
  "postCreateCommand": "python -m pip install -r requirements.txt",
  "postAttachCommand": {
    "server": "python -m streamlit run app.py --server.headless true"
  },
  "portsAttributes": {
    "8501": {
      "label": "Rebuilt",
      "onAutoForward": "openPreview"
    }
  },
  "forwardPorts": [
    8501
  ]
}
