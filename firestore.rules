rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function owner(uid) { return request.auth != null && request.auth.uid == uid; }
    function collectionPath(uid, id) { return /databases/$(database)/documents/users/$(uid)/collections/$(id); }
    function claimPath(uid, hash) { return /databases/$(database)/documents/users/$(uid)/names/$(hash); }
    function validCollection(uid, id) {
      let d = request.resource.data;
      return d.keys().hasOnly(['ownerId','name','nameKey','nameHash','revision','catalogFingerprint','payload','createdAt','updatedAt'])
        && d.ownerId == uid && d.name is string && d.name.size() > 0 && d.name.size() <= 100
        && d.name.matches('\\S([\\s\\S]*\\S)?') && d.nameKey == d.name.lower()
        && d.nameHash == hashing.sha256(d.nameKey).toHexString().lower()
        && d.revision is int && d.catalogFingerprint is string
        && d.createdAt is timestamp && d.updatedAt == request.time
        && d.payload is string && d.payload.toUtf8().size() <= 750000
        && getAfter(claimPath(uid, d.nameHash)).data.collectionId == id;
    }
    match /users/{uid}/collections/{id} {
      allow read: if owner(uid);
      allow create: if owner(uid) && validCollection(uid,id) && request.resource.data.revision == 1 && request.resource.data.createdAt == request.time;
      allow update: if owner(uid) && validCollection(uid,id)
        && request.resource.data.revision == resource.data.revision + 1
        && request.resource.data.createdAt == resource.data.createdAt
        && (request.resource.data.nameHash == resource.data.nameHash || !existsAfter(claimPath(uid,resource.data.nameHash)));
      allow delete: if owner(uid) && !existsAfter(claimPath(uid,resource.data.nameHash));
    }
    match /users/{uid}/names/{hash} {
      allow read: if owner(uid);
      allow create: if owner(uid)
        && request.resource.data.keys().hasOnly(['collectionId','nameKey'])
        && request.resource.data.collectionId is string && request.resource.data.nameKey is string
        && hash == hashing.sha256(request.resource.data.nameKey).toHexString().lower()
        && getAfter(collectionPath(uid, request.resource.data.collectionId)).data.nameHash == hash;
      // A live name claim cannot be reassigned to steal another collection's name.
      allow update: if false;
      allow delete: if owner(uid) && (!existsAfter(collectionPath(uid,resource.data.collectionId))
        || getAfter(collectionPath(uid,resource.data.collectionId)).data.nameHash != hash);
    }
    // Copies, missing adjustments and loose parts are embedded in the atomic owned
    // snapshot. No independently writable child documents or public fallthrough.
    match /{document=**} { allow read, write: if false; }
  }
}
